def jugar():
    mostrar_banner()
    nombre = input(c("👤 ¿Cuál es tu nombre? ", C.AMARILLO)).strip()
    if nombre == "":
        nombre = "Jugador"

    tema = elegir_tema()
    nivel = elegir_dificultad()

    puntaje = 0
    vidas = MAX_ERRORES
    racha = 0
    preguntas_usadas = set()
    datos_usados = set()
    ronda = 1

    info_tema = TEMAS[tema]
    print(c(
        "\n🎬 ¡Comienza el juego, {}! Tema: {} {} | Nivel: {}".format(
            nombre, info_tema["emoji"], info_tema["nombre_visible"], NOMBRES_NIVEL[nivel]
        ),
        C.BOLD,
    ))
    print("Vas a ver una palabra o frase en español. Dila en inglés cuando se te indique.\n")

    while vidas > 0:
        pregunta = elegir_pregunta(tema, nivel, preguntas_usadas)

        print(c("=" * 48, C.GRIS))
        print("Ronda " + str(ronda) + "  |  Puntaje: " + c(puntaje, C.AMARILLO))
        mostrar_vidas(vidas)
        print(c("\n📝 Palabra/frase: " + pregunta["es"].upper(), C.BOLD + C.CIAN))
        input(c("Presiona ENTER cuando estés listo para hablar... ", C.GRIS))

        archivo_audio = grabar_audio()
        texto_reconocido = reconocer_habla(archivo_audio)

        acierto = False
        if texto_reconocido:
            acierto = es_respuesta_correcta(
                texto_reconocido, pregunta["respuestas"], pregunta["es"]
            )

        if acierto:
            racha = racha + 1
            bono_racha = 0
            if racha > 1:
                bono_racha = 5 * (racha - 1)
            puntos_ronda = PUNTOS_POR_NIVEL[nivel] + bono_racha
            puntaje = puntaje + puntos_ronda

            mensaje = "✅ ¡Correcto! +" + str(puntos_ronda) + " pts"
            if bono_racha > 0:
                mensaje = mensaje + " (🔥 bono de racha x" + str(racha) + ": +" + str(bono_racha) + ")"
            print(c(mensaje, C.VERDE))
        else:
            vidas = vidas - 1
            racha = 0
            respuesta_correcta = pregunta["respuestas"][0]
            print(c('❌ Incorrecto. La traducción correcta era: "' + respuesta_correcta + '"', C.ROJO))

        mostrar_dato_curioso(tema, datos_usados)
        ronda = ronda + 1
        print()

    print(c("\n💀 ¡GAME OVER! 💀", C.BOLD + C.ROJO))
    print(c(
        "🎯 Puntaje final de {}: {} pts | Tema: {} | Nivel: {}".format(
            nombre, puntaje, info_tema["nombre_visible"], NOMBRES_NIVEL[nivel]
        ),
        C.BOLD,
    ))

    guardar_puntaje(nombre, puntaje, tema, nivel)
    mostrar_top_puntajes(tema_filtro=tema)
    mostrar_top_puntajes()


def main():
    seguir = True
    while seguir:
        jugar()
        de_nuevo = input(c("\n¿Quieres jugar otra vez? (s/n): ", C.AMARILLO)).strip().lower()
        if de_nuevo != "s":
            seguir = False

    print(c("\n👋 ¡Gracias por jugar! See you next time!", C.VERDE))


if __name__ == "__main__":
    main()
