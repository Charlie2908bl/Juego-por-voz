            del_nivel.append(p)

    disponibles = []
    for p in del_nivel:
        if p["es"] not in usadas:
            disponibles.append(p)

    if len(disponibles) == 0:
        usadas.clear()
        disponibles = del_nivel

    pregunta = random.choice(disponibles)
    usadas.add(pregunta["es"])
    return pregunta


def mostrar_dato_curioso(tema, datos_usados):
    datos = TEMAS[tema]["datos_curiosos"]
    disponibles = []
    for d in datos:
        if d not in datos_usados:
            disponibles.append(d)

    if len(disponibles) == 0:
        datos_usados.clear()
        disponibles = datos

    dato = random.choice(disponibles)
    datos_usados.add(dato)
    print(c("\n💡 ¿Sabías qué? " + dato, C.MAGENTA))


