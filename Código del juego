# 3. UTILIDADES DE TEXTO Y VALIDACION FLEXIBLE
# ============================================================

def normalizar(texto):
    """Minusculas, sin tildes y sin signos de puntuacion."""
    texto = texto.lower().strip()
    texto = unicodedata.normalize("NFKD", texto)
    texto = texto.encode("ascii", "ignore").decode("utf-8")
    texto = re.sub(r"[^a-z0-9\s]", "", texto)
    return texto


def quitar_relleno(texto_normalizado):
    """Quita palabras de relleno para que 'its wednesday'
    y 'wednesday' se comparen como lo mismo."""
    palabras = texto_normalizado.split()
    limpio = []
    for p in palabras:
        if p not in PALABRAS_RELLENO:
            limpio.append(p)
    if len(limpio) == 0:
        return texto_normalizado
    return " ".join(limpio)


def parecido(a, b, umbral=0.8):
    return difflib.SequenceMatcher(None, a, b).ratio() >= umbral


def es_respuesta_correcta(texto_reconocido, respuestas_aceptadas, palabra_original_es):
    """Valida la respuesta de forma flexible:
    1) Alguna respuesta valida esta contenida en lo que dijo el jugador.
    2) Se parece lo suficiente (tolera errores de transcripcion).
    3) Ultimo recurso: traducir lo dicho al espanol con googletrans
       y compararlo con la palabra original."""
    texto_limpio = quitar_relleno(normalizar(texto_reconocido))

    for respuesta in respuestas_aceptadas:
        respuesta_norm = quitar_relleno(normalizar(respuesta))
        if respuesta_norm in texto_limpio or parecido(respuesta_norm, texto_limpio):
            return True

    try:
        resultado = translator.translate(texto_limpio, src="en", dest="es")
        retrotraduccion = normalizar(resultado.text)
        if parecido(retrotraduccion, normalizar(palabra_original_es), 0.75):
            return True
    except Exception:
        pass

    return False


