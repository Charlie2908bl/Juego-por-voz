def grabar_audio(nombre_archivo="respuesta.wav"):
    print(c("\n🎙  ¡Habla ahora! Grabando...", C.CIAN))
    try:
        grabacion = sd.rec(
            int(DURATION * SAMPLE_RATE),
            samplerate=SAMPLE_RATE,
            channels=1,
            dtype="int16",
        )
        sd.wait()
        wav.write(nombre_archivo, SAMPLE_RATE, grabacion)
    except Exception as error:
        print(c("⚠  No se pudo usar el microfono: " + str(error), C.AMARILLO))
        return None
    print(c("✅ Grabación completa.", C.VERDE))
    return nombre_archivo


def reconocer_habla(nombre_archivo):
    if nombre_archivo is None:
        return None

    recognizer = sr.Recognizer()
    with sr.AudioFile(nombre_archivo) as source:
        audio = recognizer.record(source)

    try:
        texto = recognizer.recognize_google(audio, language="en-US")
        print(c('🗣  Escuché: "' + texto + '"', C.GRIS))
        return texto
    except sr.UnknownValueError:
        print(c("❌ No se pudo reconocer el habla (silencio o ruido).", C.ROJO))
        return None
    except sr.RequestError as error:
        print(c("⚠  Error del servicio de reconocimiento: " + str(error), C.AMARILLO))
        return None


