def mostrar_banner():
    print(c("", C.RESET))
    print(c("    🌎🤖  ECOMIND VOICE CHALLENGE  🤖🌎", C.BOLD + C.VERDE))
    print(c("    ------------------------------------", C.VERDE))
    print(c("    Say it in English... if you can!", C.VERDE))
    print()


def mostrar_vidas(vidas):
    corazones = "❤ " * vidas + "🖤 " * (MAX_ERRORES - vidas)
    print("Vidas: " + corazones)


def guardar_puntaje(nombre, puntaje, tema, nivel):
    fecha = datetime.now().strftime("%Y-%m-%d %H:%M")
    linea = "{} | {} | tema={} | nivel={} | puntaje={}\n".format(
        fecha, nombre, tema, nivel, puntaje
    )
    with open(ARCHIVO_PUNTAJES, "a", encoding="utf-8") as archivo:
        archivo.write(linea)


def mostrar_top_puntajes(tema_filtro=None, top=5):
    if not os.path.exists(ARCHIVO_PUNTAJES):
        return

    if tema_filtro:
        titulo = "🏆 TOP PUNTAJES - " + tema_filtro.upper() + " 🏆"
    else:
        titulo = "🏆 TOP PUNTAJES GENERALES 🏆"

    print(c("\n" + titulo, C.BOLD + C.AMARILLO))
    print(c("-" * 45, C.GRIS))

    filas = []
    with open(ARCHIVO_PUNTAJES, "r", encoding="utf-8") as archivo:
        for linea in archivo:
            if tema_filtro and ("tema=" + tema_filtro + " ") not in linea:
                continue
            try:
                puntaje = int(linea.strip().split("puntaje=")[1])
                filas.append((puntaje, linea.strip()))
            except (IndexError, ValueError):
                continue

    filas.sort(reverse=True, key=lambda fila: fila[0])

    if len(filas) == 0:
        print(c("(Todavía no hay puntajes para este tema)", C.GRIS))

    for fila in filas[:top]:
        print(fila[1])

    print(c("-" * 45, C.GRIS))


